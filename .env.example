# Copy to .env.local. Base URL of the Flask backend (marswalk/backend).
# With it set, the Comms screens read /comms/passes and /comms/link from it;
# without it they show the dummy data in src/data/comms.ts.
VITE_MARSWALK_API_URL=http://localhost:5000

# Backend (Flask) — Hub checklist data. Put real values in .env (git-ignored);
# on Vercel they come from the Turso / Upstash integrations.
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=
KV_REST_API_URL=https://<name>.upstash.io
KV_REST_API_TOKEN=
