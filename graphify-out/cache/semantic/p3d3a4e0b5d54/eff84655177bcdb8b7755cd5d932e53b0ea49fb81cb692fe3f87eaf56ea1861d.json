{"nodes": [{"id": "docs_screenshots_comms", "label": "Comms screenshot (Relay link - MRS constellation, Link budget tab)", "file_type": "image", "source_file": "docs/screenshots/comms.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark-theme iPad screen that turns a statistical UHF relay link budget into glanceable go/no-go information for an EVA crew member: where in the sky the link closes, how often it fails, and per-direction margin."}, {"id": "docs_screenshots_comms_top_nav_bar", "label": "Top nav bar (MARSWALK, EVA-07 Jezero West, Hub/Plan/EVA Map/FoV/Comms/Debrief, SOL 412 clock, MRS-L3 signal, Safe pill)", "file_type": "concept", "source_file": "docs/screenshots/comms.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent mission context (sol, local Mars time, relay, safety status) visible on every screen; active tab underlined in orange accent."}, {"id": "docs_screenshots_comms_link_budget_pass_toggle", "label": "Link budget / Pass prediction segmented toggle", "file_type": "concept", "source_file": "docs/screenshots/comms.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comms is split into two sub-views (link and passes) sharing one header to avoid adding top-level tabs."}, {"id": "docs_screenshots_comms_sky_dome", "label": "Uplink margin across the sky (half-dome elevation chart)", "file_type": "concept", "source_file": "docs/screenshots/comms.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semicircular sky view (0-90 deg elevation, observer 'You - Jezero West' at center) color-graded by relay link margin (-6 to +18 dB); maps abstract margin onto physical sky geometry."}, {"id": "docs_screenshots_comms_theta_min_threshold", "label": "Theta-min 19.9 deg cuto